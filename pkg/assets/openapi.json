{
  "openapi": "3.0.3",
  "info": {
    "title": "IPMI API Wrapper",
    "description": "A lightweight REST API wrapper for the go-ipmi library that exposes IPMI functionality over HTTP",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local development server"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Health check endpoints"
    },
    {
      "name": "System",
      "description": "System information endpoints"
    },
    {
      "name": "Power",
      "description": "Power management endpoints"
    },
    {
      "name": "Sensors",
      "description": "Sensor monitoring endpoints"
    },
    {
      "name": "Chassis",
      "description": "Chassis management endpoints"
    },
    {
      "name": "FRU",
      "description": "Field Replaceable Unit endpoints"
    },
    {
      "name": "Users",
      "description": "User management endpoints"
    },
    {
      "name": "LAN",
      "description": "LAN configuration endpoints"
    }
  ],
  "components": {
    "schemas": {
      "APIResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "object",
            "description": "Response data varies by endpoint"
          },
          "error": {
            "type": "string",
            "example": "Error message if success is false"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2023-01-01T12:00:00Z"
          },
          "execution_time_ms": {
            "type": "integer",
            "example": 150
          }
        }
      },
      "SystemInfo": {
        "type": "object",
        "properties": {
          "device_id": {
            "type": "integer",
            "format": "int32"
          },
          "device_revision": {
            "type": "integer",
            "format": "int32"
          },
          "firmware_revision": {
            "type": "string"
          },
          "ipmi_version": {
            "type": "string"
          },
          "manufacturer_id": {
            "type": "integer",
            "format": "int64"
          },
          "product_id": {
            "type": "integer",
            "format": "int32"
          },
          "provide_device_sdrs": {
            "type": "boolean"
          },
          "device_available": {
            "type": "boolean"
          }
        }
      },
      "PowerStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["on", "off", "unknown"]
          }
        }
      },
      "ChassisStatus": {
        "type": "object",
        "properties": {
          "power_state": {
            "type": "string"
          },
          "last_power_event": {
            "type": "string"
          }
        }
      },
      "BootDevice": {
        "type": "object",
        "properties": {
          "device": {
            "type": "string"
          }
        }
      },
      "Sensor": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "reading": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "has_analog": {
            "type": "boolean"
          },
          "entity_id": {
            "type": "integer",
            "format": "int32"
          },
          "entity_instance": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "callin": {
            "type": "boolean"
          },
          "link_auth_enabled": {
            "type": "boolean"
          },
          "ipmi_messaging_enabled": {
            "type": "boolean"
          },
          "max_priv_level": {
            "type": "string"
          }
        }
      },
      "FRUData": {
        "type": "object",
        "properties": {
          "device_id": {
            "type": "integer",
            "format": "int32"
          },
          "device_name": {
            "type": "string"
          },
          "present": {
            "type": "boolean"
          }
        }
      },
      "SELEntry": {
        "type": "object",
        "properties": {
          "record_id": {
            "type": "integer",
            "format": "int32"
          },
          "type": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        }
      },
      "LANConfig": {
        "type": "object",
        "properties": {
          "ip_address": {
            "type": "string"
          },
          "mac_address": {
            "type": "string"
          },
          "subnet_mask": {
            "type": "string"
          },
          "gateway_ip": {
            "type": "string"
          },
          "gateway_mac": {
            "type": "string"
          },
          "primary_dns": {
            "type": "string"
          },
          "secondary_dns": {
            "type": "string"
          },
          "vlan_id": {
            "type": "integer",
            "format": "int32"
          },
          "vlan_priority": {
            "type": "integer",
            "format": "int32"
          }
        }
      }
    },
    "parameters": {
      "XIPMIHost": {
        "name": "X-IPMI-Host",
        "in": "header",
        "description": "IPMI target host",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "XIPMIPort": {
        "name": "X-IPMI-Port",
        "in": "header",
        "description": "IPMI target port",
        "required": false,
        "schema": {
          "type": "integer",
          "format": "int32"
        }
      },
      "XIPMIUsername": {
        "name": "X-IPMI-Username",
        "in": "header",
        "description": "IPMI username",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "XIPMIPassword": {
        "name": "X-IPMI-Password",
        "in": "header",
        "description": "IPMI password",
        "required": false,
        "schema": {
          "type": "string"
        }
      }
    }
  },
